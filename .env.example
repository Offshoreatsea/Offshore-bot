# Скопируйте этот файл в .env и заполните своими значениями

# Токен от @BotFather (команда /newbot)
BOT_TOKEN=

# Username бота без @ (например offshoreatsea_poster_bot)
BOT_USERNAME=

# Ваш Telegram ID (узнать через @userinfobot). Несколько — через запятую
ADMIN_IDS=

# Username канала без @ (например offshoreatsea)
CHANNEL_USERNAME=offshoreatsea

# Ссылка на отклик под кнопкой "Откликнуться" — пока ссылка на сам канал,
# позже смените на бота-приём заявок или email вида mailto:you@example.com
APPLY_BOT_LINK=
