<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>OFFSHOREATSEA — vacancies</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
  :root {
    --bg: var(--tg-theme-bg-color, #ffffff);
    --secondary-bg: var(--tg-theme-secondary-bg-color, #f2f2f7);
    --text: var(--tg-theme-text-color, #0b0b0c);
    --hint: var(--tg-theme-hint-color, #8a8a8e);
    --link: var(--tg-theme-link-color, #1c7c74);
    --button: var(--tg-theme-button-color, #1c7c74);
    --button-text: var(--tg-theme-button-text-color, #ffffff);
    --divider: rgba(120, 120, 128, 0.24);
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    padding-bottom: 24px;
  }

  .toolbar {
    position: sticky;
    top: 0;
    background: var(--bg);
    padding: 12px 16px 10px;
    border-bottom: 1px solid var(--divider);
    z-index: 5;
  }
  .toolbar-title {
    font-size: 20px;
    font-weight: 650;
    letter-spacing: -0.01em;
    margin: 0 0 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .toolbar-title .anchor { font-size: 18px; opacity: 0.7; }

  .search-row {
    display: flex;
    gap: 8px;
  }
  .search-input {
    flex: 1;
    background: var(--secondary-bg);
    border: none;
    border-radius: 10px;
    padding: 9px 12px;
    font-size: 15px;
    color: var(--text);
  }
  .search-input::placeholder { color: var(--hint); }
  .region-select {
    background: var(--secondary-bg);
    border: none;
    border-radius: 10px;
    padding: 9px 10px;
    font-size: 15px;
    color: var(--text);
    max-width: 40%;
  }

  .empty, .loading {
    padding: 40px 20px;
    text-align: center;
    color: var(--hint);
    font-size: 15px;
  }

  .list { margin-top: 4px; }
  .row {
    padding: 12px 16px;
    border-bottom: 1px solid var(--divider);
  }
  .row-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    cursor: pointer;
  }
  .row-title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
  }
  .row-chevron {
    color: var(--hint);
    font-size: 13px;
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }
  .row.open .row-chevron { transform: rotate(90deg); }
  .row-meta {
    margin-top: 3px;
    font-size: 13.5px;
    color: var(--hint);
  }

  .row-details {
    display: none;
    margin-top: 12px;
    font-size: 14.5px;
    line-height: 1.5;
  }
  .row.open .row-details { display: block; }
  .detail-line { margin-bottom: 6px; }
  .detail-label { color: var(--hint); }
  .bullets { margin: 4px 0 10px; padding-left: 18px; }
  .bullets li { margin-bottom: 3px; }

  .respond-btn, .send-btn {
    width: 100%;
    background: var(--button);
    color: var(--button-text);
    border: none;
    border-radius: 10px;
    padding: 11px;
    font-size: 15px;
    font-weight: 600;
    margin-top: 6px;
    cursor: pointer;
  }
  .respond-btn:active, .send-btn:active { opacity: 0.85; }

  .apply-form { display: none; margin-top: 12px; }
  .apply-form.open { display: block; }
  .apply-form input, .apply-form textarea {
    width: 100%;
    background: var(--secondary-bg);
    border: none;
    border-radius: 10px;
    padding: 9px 12px;
    font-size: 15px;
    color: var(--text);
    margin-bottom: 8px;
    font-family: inherit;
  }
  .apply-form textarea { resize: vertical; min-height: 60px; }

  .status-line {
    margin-top: 8px;
    font-size: 14px;
    color: var(--link);
    display: none;
  }
  .status-line.show { display: block; }
</style>
</head>
<body>

<div class="toolbar">
  <p class="toolbar-title"><span class="anchor">⚓</span> Vacancies</p>
  <div class="search-row">
    <input class="search-input" id="searchInput" type="text" placeholder="Position, vessel, requirements…">
    <select class="region-select" id="regionSelect">
      <option value="">All regions</option>
    </select>
  </div>
</div>

<div id="content">
  <div class="loading">Loading…</div>
</div>

<script>
const tg = window.Telegram?.WebApp;
if (tg) { tg.ready(); tg.expand(); }

const state = { region: "", q: "", vacancies: [], openId: null };

async function loadFilters() {
  try {
    const res = await fetch("/api/filters");
    const data = await res.json();
    const select = document.getElementById("regionSelect");
    (data.regions || []).forEach(r => {
      const opt = document.createElement("option");
      opt.value = r; opt.textContent = r;
      select.appendChild(opt);
    });
  } catch (e) { /* region filter is optional, fail silently */ }
}

async function loadVacancies() {
  const content = document.getElementById("content");
  content.innerHTML = '<div class="loading">Loading…</div>';
  const params = new URLSearchParams();
  if (state.region) params.set("region", state.region);
  if (state.q) params.set("q", state.q);
  try {
    const res = await fetch("/api/vacancies?" + params.toString());
    state.vacancies = await res.json();
  } catch (e) {
    content.innerHTML = '<div class="empty">Couldn't load vacancies. Pull down to refresh.</div>';
    return;
  }
  render();
}

function fieldLine(label, value) {
  if (!value) return "";
  return `<div class="detail-line"><span class="detail-label">${label}:</span> ${escapeHtml(value)}</div>`;
}

function bulletsBlock(label, items) {
  if (!items || !items.length) return "";
  const lis = items.map(i => `<li>${escapeHtml(i)}</li>`).join("");
  return `<div class="detail-label">${label}:</div><ul class="bullets">${lis}</ul>`;
}

function escapeHtml(s) {
  const div = document.createElement("div");
  div.textContent = s;
  return div.innerHTML;
}

function render() {
  const content = document.getElementById("content");
  if (!state.vacancies.length) {
    content.innerHTML = '<div class="empty">Nothing found. Try a different search or region.</div>';
    return;
  }
  const html = state.vacancies.map(v => {
    const meta = [v.vessel, v.region, v.rotation].filter(Boolean).join(" • ");
    const isOpen = state.openId === v.id;
    return `
      <div class="row ${isOpen ? "open" : ""}" data-id="${v.id}">
        <div class="row-head" onclick="toggleRow(${v.id})">
          <div>
            <div class="row-title">${escapeHtml(v.position || "Vacancy")}</div>
            <div class="row-meta">${escapeHtml(meta)}</div>
          </div>
          <div class="row-chevron">›</div>
        </div>
        <div class="row-details">
          ${fieldLine("Nationality", v.nationality)}
          ${fieldLine("Date", v.date)}
          ${fieldLine("Duration", v.duration)}
          ${fieldLine("Salary", v.salary)}
          ${bulletsBlock("Documents", v.documents)}
          ${bulletsBlock("Requirements", v.requirements)}
          <button class="respond-btn" onclick="openForm(${v.id})">Apply</button>
          <div class="apply-form" id="form-${v.id}">
            <input type="text" placeholder="Your name" id="name-${v.id}">
            <input type="text" placeholder="Email or phone to contact you" id="contact-${v.id}">
            <textarea placeholder="Message (optional)" id="message-${v.id}"></textarea>
            <button class="send-btn" onclick="submitForm(${v.id})">Send application</button>
            <div class="status-line" id="status-${v.id}"></div>
          </div>
        </div>
      </div>`;
  }).join("");
  content.innerHTML = `<div class="list">${html}</div>`;
}

function toggleRow(id) {
  state.openId = state.openId === id ? null : id;
  render();
}

function openForm(id) {
  const form = document.getElementById(`form-${id}`);
  form.classList.add("open");
}

async function submitForm(id) {
  const name = document.getElementById(`name-${id}`).value.trim();
  const contact = document.getElementById(`contact-${id}`).value.trim();
  const message = document.getElementById(`message-${id}`).value.trim();
  const statusEl = document.getElementById(`status-${id}`);

  if (!contact) {
    statusEl.textContent = "Enter an email or phone number to contact you.";
    statusEl.classList.add("show");
    return;
  }

  try {
    const res = await fetch("/api/apply", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        initData: tg ? tg.initData : "",
        vacancy_id: id, name, contact, message,
      }),
    });
    const data = await res.json();
    if (data.ok) {
      statusEl.textContent = "Application sent ✓";
      statusEl.classList.add("show");
      if (tg) tg.HapticFeedback?.notificationOccurred("success");
    } else {
      statusEl.textContent = "Couldn't send, please try again.";
      statusEl.classList.add("show");
    }
  } catch (e) {
    statusEl.textContent = "Couldn't send, check your connection.";
    statusEl.classList.add("show");
  }
}

let searchTimer;
document.getElementById("searchInput").addEventListener("input", (e) => {
  state.q = e.target.value;
  clearTimeout(searchTimer);
  searchTimer = setTimeout(loadVacancies, 350);
});
document.getElementById("regionSelect").addEventListener("change", (e) => {
  state.region = e.target.value;
  loadVacancies();
});

loadFilters();
loadVacancies();
</script>
</body>
</html>
